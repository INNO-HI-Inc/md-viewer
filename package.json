{
  "name": "md-pretty-viewer",
  "displayName": "MD Pretty Viewer",
  "description": "A beautiful markdown editor with live preview, formatting toolbar, and outline sidebar",
  "version": "0.2.0",
  "publisher": "innohi",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/INNO-HI-Inc/md-viewer"
  },
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.74.0"
  },
  "main": "./extension.js",
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "contributes": {
    "customEditors": [
      {
        "viewType": "mdPrettyViewer.editor",
        "displayName": "MD Pretty Viewer",
        "selector": [
          {
            "filenamePattern": "*.md"
          }
        ],
        "priority": "default"
      }
    ]
  }
}
