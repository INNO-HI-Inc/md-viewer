{
  "name": "md-pretty-viewer",
  "displayName": "MD Pretty Viewer — Markdown Preview & PDF",
  "description": "Beautiful markdown preview + one-click PDF export — made for the docs Claude Code, Cursor & Copilot write for you. 13 color themes · LaTeX math · Mermaid diagrams · Korean typography bundled · fully offline. — Claude Code·Cursor가 만든 마크다운을 예쁘게 읽고 PDF로. 13가지 테마, LaTeX 수식, Mermaid 다이어그램, 한글 폰트 번들.",
  "version": "2.0.0",
  "publisher": "innohi",
  "author": {
    "name": "INNO-HI Inc.",
    "url": "https://www.innohi.ai.kr"
  },
  "license": "MIT",
  "homepage": "https://inno-hi-inc.github.io/md-viewer/",
  "repository": {
    "type": "git",
    "url": "https://github.com/INNO-HI-Inc/md-viewer.git"
  },
  "bugs": {
    "url": "https://github.com/INNO-HI-Inc/md-viewer/issues",
    "email": "hello@innohi.ai.kr"
  },
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#0E1128",
    "theme": "dark"
  },
  "qna": "https://github.com/INNO-HI-Inc/md-viewer/issues",
  "keywords": [
    "markdown",
    "markdown preview",
    "markdown pdf",
    "markdown editor",
    "preview",
    "viewer",
    "md",
    "pdf",
    "pdf export",
    "claude",
    "claude code",
    "cursor",
    "copilot",
    "ai docs",
    "notion",
    "outline",
    "latex",
    "katex",
    "math",
    "mermaid",
    "diagram",
    "gfm",
    "github",
    "마크다운",
    "프리뷰",
    "에디터",
    "뷰어",
    "한글",
    "한국어",
    "korean"
  ],
  "engines": {
    "vscode": "^1.74.0"
  },
  "main": "./extension.js",
  "categories": [
    "Visualization",
    "Formatters"
  ],
  "extensionKind": [
    "ui",
    "workspace"
  ],
  "activationEvents": [
    "onLanguage:markdown",
    "onCommand:mdPrettyViewer.open",
    "onStartupFinished",
    "onCommand:mdPrettyViewer.changeLanguage"
  ],
  "contributes": {
    "customEditors": [
      {
        "viewType": "mdPrettyViewer.editor",
        "displayName": "MD Pretty Viewer",
        "selector": [
          {
            "filenamePattern": "*.md"
          },
          {
            "filenamePattern": "*.markdown"
          },
          {
            "filenamePattern": "*.mdown"
          },
          {
            "filenamePattern": "*.mkd"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "mdPrettyViewer.open",
        "title": "Open Pretty View",
        "category": "MD Pretty Viewer",
        "icon": "$(preview)"
      },
      {
        "command": "mdPrettyViewer.toggleMode",
        "title": "Toggle Preview/Edit Mode",
        "category": "MD Pretty Viewer"
      },
      {
        "command": "mdPrettyViewer.bold",
        "title": "Bold",
        "category": "MD Pretty Viewer"
      },
      {
        "command": "mdPrettyViewer.italic",
        "title": "Italic",
        "category": "MD Pretty Viewer"
      },
      {
        "command": "mdPrettyViewer.code",
        "title": "Code",
        "category": "MD Pretty Viewer"
      },
      {
        "command": "mdPrettyViewer.changeLanguage",
        "title": "%command.changeLanguage%",
        "category": "MD Pretty Viewer",
        "icon": "$(globe)"
      }
    ],
    "keybindings": [
      {
        "command": "mdPrettyViewer.toggleMode",
        "key": "ctrl+e",
        "mac": "cmd+e",
        "when": "activeCustomEditorId == 'mdPrettyViewer.editor'"
      },
      {
        "command": "mdPrettyViewer.bold",
        "key": "ctrl+b",
        "mac": "cmd+b",
        "when": "activeCustomEditorId == 'mdPrettyViewer.editor'"
      },
      {
        "command": "mdPrettyViewer.italic",
        "key": "ctrl+i",
        "mac": "cmd+i",
        "when": "activeCustomEditorId == 'mdPrettyViewer.editor'"
      },
      {
        "command": "mdPrettyViewer.code",
        "key": "ctrl+shift+c",
        "mac": "cmd+shift+c",
        "when": "activeCustomEditorId == 'mdPrettyViewer.editor'"
      },
      {
        "command": "mdPrettyViewer.open",
        "key": "ctrl+alt+m",
        "mac": "cmd+alt+m",
        "when": "resourceExtname == '.md' || resourceExtname == '.markdown' || resourceExtname == '.mdown' || resourceExtname == '.mkd'"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "mdPrettyViewer.open",
          "when": "resourceExtname == '.md' || resourceExtname == '.markdown'",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "mdPrettyViewer.open",
          "when": "resourceExtname == '.md' || resourceExtname == '.markdown'",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "MD Pretty Viewer",
      "properties": {
        "mdPrettyViewer.defaultTheme": {
          "type": "string",
          "enum": [
            "blue",
            "green",
            "rose",
            "purple",
            "amber",
            "neutral",
            "mono",
            "peach",
            "aqua",
            "orchid",
            "sage",
            "sepia",
            "mist"
          ],
          "enumDescriptions": [
            "%config.defaultTheme.enum.blue%",
            "%config.defaultTheme.enum.green%",
            "%config.defaultTheme.enum.rose%",
            "%config.defaultTheme.enum.purple%",
            "%config.defaultTheme.enum.amber%",
            "%config.defaultTheme.enum.neutral%",
            "%config.defaultTheme.enum.mono%",
            "%config.defaultTheme.enum.peach%",
            "%config.defaultTheme.enum.aqua%",
            "%config.defaultTheme.enum.orchid%",
            "%config.defaultTheme.enum.sage%",
            "%config.defaultTheme.enum.sepia%",
            "%config.defaultTheme.enum.mist%"
          ],
          "default": "blue",
          "description": "%config.defaultTheme.description%"
        },
        "mdPrettyViewer.defaultFontSize": {
          "type": "number",
          "default": 16,
          "minimum": 12,
          "maximum": 24,
          "description": "%config.defaultFontSize.description%"
        },
        "mdPrettyViewer.defaultMode": {
          "type": "string",
          "enum": [
            "preview",
            "edit",
            "split"
          ],
          "enumDescriptions": [
            "%config.defaultMode.enum.preview%",
            "%config.defaultMode.enum.edit%",
            "%config.defaultMode.enum.split%"
          ],
          "default": "preview",
          "description": "%config.defaultMode.description%"
        },
        "mdPrettyViewer.showOutline": {
          "type": "boolean",
          "default": false,
          "description": "%config.showOutline.description%"
        },
        "mdPrettyViewer.mermaidLevelColors": {
          "type": "boolean",
          "default": false,
          "description": "%config.mermaidLevelColors.description%"
        },
        "mdPrettyViewer.language": {
          "type": "string",
          "enum": [
            "auto",
            "en",
            "ko"
          ],
          "enumDescriptions": [
            "%config.language.enum.auto%",
            "%config.language.enum.en%",
            "%config.language.enum.ko%"
          ],
          "default": "auto",
          "description": "%config.language.description%"
        }
      }
    }
  }
}
